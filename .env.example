# Sitenin canlı adresi (sitemap, canonical ve OG etiketleri için kullanılır)
NEXT_PUBLIC_SITE_URL=https://www.rebirthsoftware.com

# --- Teklif formu e-posta gönderimi (opsiyonel ama önerilir) ---
# https://resend.com adresinden ücretsiz hesap açıp API anahtarı alın.
# Bu değişken tanımlı DEĞİLSE form çalışmaya devam eder,
# ancak talepler sadece Vercel sunucu günlüklerine yazılır, e-posta gitmez.
RESEND_API_KEY=
# Formun düşeceği adres
CONTACT_TO_EMAIL=info@rebirthsoftware.com
# Gönderen adresi. Kendi alan adınızı Resend'de doğruladıktan sonra
# "Teklif Formu <teklif@rebirthsoftware.com>" şeklinde güncelleyin.
CONTACT_FROM_EMAIL=Teklif Formu <onboarding@resend.dev>
