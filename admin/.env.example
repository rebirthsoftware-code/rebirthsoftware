# --- Giriş ---
# Panele giriş parolası. Uzun ve tahmin edilmesi zor bir şey seçin.
ADMIN_PAROLA=

# Oturum çerezini imzalayan gizli anahtar (isteğe bağlı; boşsa paroladan türetilir).
OTURUM_GIZLI=

# --- İçerik deposu: GitHub ---
# Tanımlıysa panel, içerikleri doğrudan GitHub'daki depoya yazar; her kayıt
# bir commit olur ve GitHub Pages siteyi otomatik yeniden yayınlar.
# Boşsa panel yerel modda çalışır: ../content klasörünü okur/yazar (geliştirme).
#
# Token: GitHub → Settings → Developer settings → Fine-grained tokens →
# yalnızca bu depo, izinler: Contents (Read and write), Issues (Read and write),
# Actions (Read).
GITHUB_TOKEN=
GITHUB_REPO=rebirthsoftware-code/rebirthsoftware
# Sitenin yayınlandığı dal (GitHub Pages iş akışının dinlediği dal)
GITHUB_BRANCH=claude/website-review-fztdup

# --- Teklif formu ---
# Sitenin teklif formu bu panelin /api/teklif ucuna gönderir. İzin verilen
# site adresleri (virgülle ayrılmış, şema dahil):
SITE_ORIGINS=https://rebirthsoftware-code.github.io,https://www.rebirthsoftware.com

# İsteğe bağlı: her yeni talep ayrıca e-posta olarak da gelsin (Resend).
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@rebirthsoftware.com
CONTACT_FROM_EMAIL=Teklif Formu <onboarding@resend.dev>

# Panelin canlı adresi (manifest ve bağlantılar için)
NEXT_PUBLIC_PANEL_URL=https://yonetim.rebirthsoftware.com

# Sitenin canlı adresi (panelde proje küçük resimleri buradan gösterilir)
NEXT_PUBLIC_SITE_URL=https://rebirthsoftware-code.github.io/rebirthsoftware
